# 1. Telegram Bot Token from @BotFather (https://core.telegram.org/bots/tutorial)
TELEGRAM_BOT_TOKEN="1234567890:AAH_your_botfather_token_here"

# Optional: Comma-separated Telegram User IDs allowed to use your internal agency bot
# Leave blank to allow any user who messages the bot
ALLOWED_TELEGRAM_USER_IDS=""

# 2. Google Gemini API Key from Google AI Studio (https://aistudio.google.com/docs/get-started)
GEMINI_API_KEY="AIzaSy_your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.8-flash"

# 3. Apify API Token for scraping TikTok & Instagram handles (https://apify.com/)
APIFY_API_TOKEN="apify_api_your_token_here"

# 4. Supabase Project URL & Service Role Key (https://supabase.com/)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 5. Your Deployed Vercel Domain (used to auto-register the Telegram webhook)
NEXT_PUBLIC_APP_URL="https://your-bot-project.vercel.app"
